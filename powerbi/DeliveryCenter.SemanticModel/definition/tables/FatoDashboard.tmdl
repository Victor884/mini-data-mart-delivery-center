	partition FatoDashboard = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(#"Arquivo Snapshot"), [Delimiter = ",", Columns = 46, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {
					{"order_id", Int64.Type}, {"data_pedido", type date}, {"ano", Int64.Type}, {"mes_numero", Int64.Type},
					{"mes_nome", type text}, {"mes_ano", type text}, {"mes_ordem", Int64.Type}, {"mes_indice", Int64.Type}, {"hub_id", Int64.Type},
					{"hub_nome", type text}, {"hub_cidade", type text}, {"hub_estado", type text}, {"store_id", Int64.Type},
					{"loja_nome", type text}, {"segmento_loja", type text}, {"channel_id", Int64.Type}, {"canal_nome", type text},
					{"tipo_canal", type text}, {"status_pedido", type text}, {"valor_pedido", type number}, {"taxa_entrega", type number},
					{"custo_entrega", type number}, {"valor_total_pedido", type number}, {"margem_entrega", type number},
					{"tempo_producao_minutos", type number}, {"tempo_transito_minutos", type number}, {"tempo_ciclo_total_minutos", type number},
					{"possui_entrega", type logical}, {"delivery_id", Int64.Type}, {"status_entrega", type text},
					{"numero_tentativas", Int64.Type}, {"distancia_entrega_metros", Int64.Type}, {"modal_entregador", type text}, {"tipo_entregador", type text},
					{"qtd_pagamentos", Int64.Type}, {"qtd_pagamentos_pagos", Int64.Type}, {"qtd_chargebacks", Int64.Type}, {"qtd_pagamentos_aguardando", Int64.Type},
					{"total_pago_confirmado", type number}, {"total_chargeback", type number}, {"total_aguardando", type number}, {"taxas_pagamentos_pagos", type number},
					{"valor_pago_apos_taxas", type number}, {"diferenca_conciliacao", type number}, {"status_conciliacao", type text}, {"meio_pagamento_principal", type text}
				}, "en-US")
			in
				ChangedTypes

	annotation PBI_ResultType = Table
