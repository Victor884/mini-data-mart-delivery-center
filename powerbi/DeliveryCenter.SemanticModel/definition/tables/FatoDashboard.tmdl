table FatoDashboard
	measure 'Pedidos Criados' = COUNTROWS(FatoDashboard)
		formatString: #,0
		displayFolder: Comercial

	measure 'Pedidos Finalizados' = CALCULATE([Pedidos Criados], FatoDashboard[Status do Pedido] = "FINISHED")
		formatString: #,0
		displayFolder: Comercial

	measure 'Pedidos Cancelados' = CALCULATE([Pedidos Criados], FatoDashboard[Status do Pedido] = "CANCELED")
		formatString: #,0
		displayFolder: Comercial

	measure 'Taxa de Cancelamento' = DIVIDE([Pedidos Cancelados], [Pedidos Criados])
		formatString: 0.00%
		displayFolder: Comercial

	measure 'Valor Transacionado Finalizado' = CALCULATE(SUM(FatoDashboard[Valor Total Pedido]), FatoDashboard[Status do Pedido] = "FINISHED")
		formatString: R$ #,##0.00
		displayFolder: Comercial

	measure 'Ticket Médio Finalizado' = DIVIDE([Valor Transacionado Finalizado], [Pedidos Finalizados])
		formatString: R$ #,##0.00
		displayFolder: Comercial

	measure 'Margem de Entrega' = CALCULATE(SUM(FatoDashboard[Margem Entrega]), FatoDashboard[Status do Pedido] = "FINISHED")
		formatString: R$ #,##0.00;[Red]-R$ #,##0.00
		displayFolder: Comercial

	measure 'Tempo Ciclo P50' =
			PERCENTILEX.INC(
				FILTER(FatoDashboard, FatoDashboard[Status do Pedido] = "FINISHED" && FatoDashboard[Tempo Ciclo Total (min)] >= 0),
				FatoDashboard[Tempo Ciclo Total (min)],
				0.5
			)
		formatString: 0.00 "min"
		displayFolder: Experiência

	measure 'Tempo Ciclo P90' =
			PERCENTILEX.INC(
				FILTER(FatoDashboard, FatoDashboard[Status do Pedido] = "FINISHED" && FatoDashboard[Tempo Ciclo Total (min)] >= 0),
				FatoDashboard[Tempo Ciclo Total (min)],
				0.9
			)
		formatString: 0.00 "min"
		displayFolder: Experiência

	measure 'Pedidos com Entrega' = CALCULATE([Pedidos Criados], FatoDashboard[Possui Entrega] = TRUE())
		formatString: #,0
		displayFolder: Logística

	measure 'Entregas Concluídas' = CALCULATE([Pedidos com Entrega], FatoDashboard[Status da Entrega] = "DELIVERED")
		formatString: #,0
		displayFolder: Logística

	measure 'Entregas Não Concluídas' = [Pedidos com Entrega] - [Entregas Concluídas]
		formatString: #,0
		displayFolder: Logística

	measure 'Taxa Entrega Concluída' = DIVIDE([Entregas Concluídas], [Pedidos com Entrega])
		formatString: 0.00%
		displayFolder: Logística

	measure 'Pedidos Múltiplas Tentativas' = CALCULATE([Pedidos com Entrega], FatoDashboard[Número de Tentativas] > 1)
		formatString: #,0
		displayFolder: Logística

	measure 'Taxa Múltiplas Tentativas' = DIVIDE([Pedidos Múltiplas Tentativas], [Pedidos com Entrega])
		formatString: 0.00%
		displayFolder: Logística

	measure 'Tempo Ciclo Logístico P50' =
			PERCENTILEX.INC(
				FILTER(FatoDashboard, FatoDashboard[Possui Entrega] = TRUE() && FatoDashboard[Status do Pedido] = "FINISHED" && FatoDashboard[Tempo Ciclo Total (min)] >= 0),
				FatoDashboard[Tempo Ciclo Total (min)],
				0.5
			)
		formatString: 0.00 "min"
		displayFolder: Logística

	measure 'Tempo Ciclo Logístico P90' =
			PERCENTILEX.INC(
				FILTER(FatoDashboard, FatoDashboard[Possui Entrega] = TRUE() && FatoDashboard[Status do Pedido] = "FINISHED" && FatoDashboard[Tempo Ciclo Total (min)] >= 0),
				FatoDashboard[Tempo Ciclo Total (min)],
				0.9
			)
		formatString: 0.00 "min"
		displayFolder: Logística

	measure 'Distância Média Entrega (km)' = DIVIDE(CALCULATE(AVERAGE(FatoDashboard[Distância da Entrega (m)]), FatoDashboard[Status da Entrega] = "DELIVERED"), 1000)
		formatString: 0.00 "km"
		displayFolder: Logística

	measure 'Tempo Produção Médio' =
			AVERAGEX(
				FILTER(FatoDashboard, FatoDashboard[Status do Pedido] = "FINISHED" && FatoDashboard[Tempo de Produção (min)] >= 0),
				FatoDashboard[Tempo de Produção (min)]
			)
		formatString: 0.00 "min"
		displayFolder: Operação

	measure 'Tempo Trânsito Médio' =
			AVERAGEX(
				FILTER(FatoDashboard, FatoDashboard[Status do Pedido] = "FINISHED" && FatoDashboard[Tempo de Trânsito (min)] >= 0),
				FatoDashboard[Tempo de Trânsito (min)]
			)
		formatString: 0.00 "min"
		displayFolder: Operação

	measure 'Transações Pagas' = SUM(FatoDashboard[Qtd Pagamentos Pagos])
		formatString: #,0
		displayFolder: Financeiro

	measure 'Valor Pago' = SUM(FatoDashboard[Total Pago Confirmado])
		formatString: R$ #,##0.00
		displayFolder: Financeiro

	measure 'Taxas Pagamento' = SUM(FatoDashboard[Taxas Pagamentos Pagos])
		formatString: R$ #,##0.00
		displayFolder: Financeiro

	measure 'Valor Líquido Pago' = SUM(FatoDashboard[Valor Pago Após Taxas])
		formatString: R$ #,##0.00
		displayFolder: Financeiro

	measure Chargebacks = SUM(FatoDashboard[Qtd Chargebacks])
		formatString: #,0
		displayFolder: Financeiro

	measure 'Valor Chargeback' = SUM(FatoDashboard[Total Chargeback])
		formatString: R$ #,##0.00
		displayFolder: Financeiro

	measure 'Pedidos Conciliados' =
			CALCULATE(
				[Pedidos Criados],
				FatoDashboard[Status do Pedido] = "FINISHED",
				FatoDashboard[Status Conciliação] = "CONCILIADO"
			)
		formatString: #,0
		displayFolder: Financeiro

	measure 'Pedidos Finalizados Conciliação' = [Pedidos Finalizados]
		formatString: #,0
		displayFolder: Financeiro

	measure 'Taxa Conciliação' = DIVIDE([Pedidos Conciliados], [Pedidos Finalizados Conciliação])
		formatString: 0.00%
		displayFolder: Financeiro

	measure 'Diferença Absoluta Conciliação' =
			SUMX(
				FILTER(FatoDashboard, FatoDashboard[Status do Pedido] = "FINISHED"),
				ABS(FatoDashboard[Diferença Conciliação])
			)
		formatString: R$ #,##0.00
		displayFolder: Financeiro

	measure 'Pedidos sem Pagamento Pago' =
			CALCULATE(
				[Pedidos Criados],
				FatoDashboard[Status do Pedido] = "FINISHED",
				FatoDashboard[Status Conciliação] IN { "SEM_PAGAMENTO", "SEM_PAGAMENTO_PAGO" }
			)
		formatString: #,0
		displayFolder: Financeiro

	measure 'Valor Transacionado Mês Anterior' =
			VAR MesAtual = MAX(FatoDashboard[Índice Mês])
			RETURN
				CALCULATE(
					[Valor Transacionado Finalizado],
					REMOVEFILTERS(FatoDashboard[Data], FatoDashboard[Ano], FatoDashboard[Número do Mês], FatoDashboard[Nome do Mês], FatoDashboard[Mês/Ano], FatoDashboard[Ordem Mês], FatoDashboard[Índice Mês]),
					FatoDashboard[Índice Mês] = MesAtual - 1
				)
		formatString: R$ #,##0.00
		displayFolder: Comparações

	measure 'Variação Absoluta Valor Transacionado' = [Valor Transacionado Finalizado] - [Valor Transacionado Mês Anterior]
		formatString: R$ #,##0.00
		displayFolder: Comparações

	measure 'Variação Valor Transacionado Mensal' = DIVIDE([Variação Absoluta Valor Transacionado], [Valor Transacionado Mês Anterior])
		formatString: 0.00%
		displayFolder: Comparações

	measure 'Pedidos Mês Anterior' =
			VAR MesAtual = MAX(FatoDashboard[Índice Mês])
			RETURN
				CALCULATE(
					[Pedidos Criados],
					REMOVEFILTERS(FatoDashboard[Data], FatoDashboard[Ano], FatoDashboard[Número do Mês], FatoDashboard[Nome do Mês], FatoDashboard[Mês/Ano], FatoDashboard[Ordem Mês], FatoDashboard[Índice Mês]),
					FatoDashboard[Índice Mês] = MesAtual - 1
				)
		formatString: #,0
		displayFolder: Comparações

	measure 'Variação Absoluta Pedidos' = [Pedidos Criados] - [Pedidos Mês Anterior]
		formatString: #,0
		displayFolder: Comparações

	measure 'Variação Pedidos Mensal' = DIVIDE([Variação Absoluta Pedidos], [Pedidos Mês Anterior])
		formatString: 0.00%
		displayFolder: Comparações

	measure 'Valor Pago Mês Anterior' =
			VAR MesAtual = MAX(FatoDashboard[Índice Mês])
			RETURN
				CALCULATE(
					[Valor Pago],
					REMOVEFILTERS(FatoDashboard[Data], FatoDashboard[Ano], FatoDashboard[Número do Mês], FatoDashboard[Nome do Mês], FatoDashboard[Mês/Ano], FatoDashboard[Ordem Mês], FatoDashboard[Índice Mês]),
					FatoDashboard[Índice Mês] = MesAtual - 1
				)
		formatString: R$ #,##0.00
		displayFolder: Comparações

	measure 'Variação Absoluta Valor Pago' = [Valor Pago] - [Valor Pago Mês Anterior]
		formatString: R$ #,##0.00
		displayFolder: Comparações

	measure 'Variação Valor Pago Mensal' = DIVIDE([Variação Absoluta Valor Pago], [Valor Pago Mês Anterior])
		formatString: 0.00%
		displayFolder: Comparações

	measure 'Tempo Ciclo Médio' = AVERAGEX(FILTER(FatoDashboard, FatoDashboard[Status do Pedido] = "FINISHED" && NOT ISBLANK(FatoDashboard[Tempo de Ciclo Total (min)]) && FatoDashboard[Tempo de Ciclo Total (min)] >= 0), FatoDashboard[Tempo de Ciclo Total (min)])
		formatString: #,##0.00
		displayFolder: Operação

	measure 'Participação Valor Transacionado' = DIVIDE([Valor Transacionado Finalizado], CALCULATE([Valor Transacionado Finalizado], ALLSELECTED(FatoDashboard)))
		formatString: 0.00%
		displayFolder: Tooltips

	measure 'Participação Pedidos' = DIVIDE([Pedidos Criados], CALCULATE([Pedidos Criados], ALLSELECTED(FatoDashboard)))
		formatString: 0.00%
		displayFolder: Tooltips

	measure 'Participação Valor Pago' = DIVIDE([Valor Pago], CALCULATE([Valor Pago], ALLSELECTED(FatoDashboard)))
		formatString: 0.00%
		displayFolder: Tooltips

	measure 'Participação Pedidos com Entrega' = DIVIDE([Pedidos com Entrega], CALCULATE([Pedidos com Entrega], ALLSELECTED(FatoDashboard)))
		formatString: 0.00%
		displayFolder: Tooltips

	measure 'Contexto Tooltip' = VAR DataSelecionada = SELECTEDVALUE(FatoDashboard[Data]) RETURN COALESCE(IF(NOT ISBLANK(DataSelecionada), FORMAT(DataSelecionada, "dd/MM/yyyy")), SELECTEDVALUE(FatoDashboard[Hub]), SELECTEDVALUE(FatoDashboard[Loja]), SELECTEDVALUE(FatoDashboard[Tipo de Canal]), SELECTEDVALUE(FatoDashboard[Modal do Entregador]), SELECTEDVALUE(FatoDashboard[Meio Pagamento Principal]), SELECTEDVALUE(FatoDashboard[Status do Pedido]), SELECTEDVALUE(FatoDashboard[Status Conciliação]), "Contexto selecionado")
		formatString: General
		displayFolder: Tooltips

	measure 'HTML | KPIs Executivos' = VAR Periodo = FORMAT(MIN(FatoDashboard[Data]), "dd/MM/yyyy") & " a " & FORMAT(MAX(FatoDashboard[Data]), "dd/MM/yyyy") VAR CorMargem = IF([Margem de Entrega] >= 0, "#2DD4BF", "#FB7185") RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#131D31;border:1px solid #2A3955;border-radius:12px;padding:9px 12px;box-sizing:border-box;width:100%;height:100%;overflow:hidden;'><div style='display:flex;justify-content:space-between;margin-bottom:6px;'><b style='font-size:11px;'>RESULTADO DO PERÍODO</b><span style='font-size:9px;color:#9FB0C7;'>" & Periodo & "</span></div><div style='display:flex;gap:8px;height:58px;'><div style='flex:1;background:#1A2540;border-left:4px solid #3B82F6;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>VALOR TRANSACIONADO</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Valor Transacionado Finalizado], "R$ #,##0.00", "pt-BR") & "</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #22D3EE;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>PEDIDOS FINALIZADOS</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Pedidos Finalizados], "#,##0", "pt-BR") & "</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #8B5CF6;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>TICKET MÉDIO</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Ticket Médio Finalizado], "R$ #,##0.00", "pt-BR") & "</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #FBBF24;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>CANCELAMENTO</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Taxa de Cancelamento], "0.00%", "pt-BR") & "</div></div><div style='flex:1;background:#1A2540;border-left:4px solid " & CorMargem & ";border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>MARGEM ENTREGA</small><div style='font-size:18px;font-weight:750;margin-top:4px;color:" & CorMargem & ";'>" & FORMAT([Margem de Entrega], "R$ #,##0.00", "pt-BR") & "</div></div></div></div>"
		formatString: General
		displayFolder: HTML

	measure 'HTML | Saúde Executiva' = VAR CorMargem = IF([Margem de Entrega] >= 0, "#2DD4BF", "#FB7185") RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#131D31;border:1px solid #2A3955;border-radius:12px;padding:14px 16px;box-sizing:border-box;width:100%;height:100%;'><div style='font-size:12px;font-weight:700;margin-bottom:10px;'>SAÚDE OPERACIONAL</div><div style='display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid #2A3955;font-size:11px;'><span>Taxa de cancelamento</span><b style='color:#FB7185;'>" & FORMAT([Taxa de Cancelamento], "0.00%", "pt-BR") & "</b></div><div style='display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid #2A3955;font-size:11px;'><span>Ciclo P90 <small style='color:#9FB0C7;'>(percentil)</small></span><b style='color:#FBBF24;'>" & FORMAT([Tempo Ciclo P90], "0.00", "pt-BR") & " min</b></div><div style='display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid #2A3955;font-size:11px;'><span>Taxa de conciliação</span><b style='color:#22D3EE;'>" & FORMAT([Taxa Conciliação], "0.00%", "pt-BR") & "</b></div><div style='display:flex;justify-content:space-between;padding:9px 0;font-size:11px;'><span>Margem de entrega</span><b style='color:" & CorMargem & ";'>" & FORMAT([Margem de Entrega], "R$ #,##0.00", "pt-BR") & "</b></div></div>"
		formatString: General
		displayFolder: HTML

	measure 'HTML | KPIs Pedidos' = "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#131D31;border:1px solid #2A3955;border-radius:12px;padding:9px 12px;box-sizing:border-box;width:100%;height:100%;overflow:hidden;'><div style='font-size:11px;font-weight:700;margin-bottom:6px;'>PEDIDOS E OPERAÇÃO</div><div style='display:flex;gap:8px;height:58px;'><div style='flex:1;background:#1A2540;border-left:4px solid #3B82F6;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>PEDIDOS CRIADOS</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Pedidos Criados], "#,##0", "pt-BR") & "</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #22D3EE;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>FINALIZADOS</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Pedidos Finalizados], "#,##0", "pt-BR") & "</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #FB7185;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>CANCELADOS</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Pedidos Cancelados], "#,##0", "pt-BR") & "</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #FB7185;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>TAXA CANCELAMENTO</small><div style='font-size:18px;font-weight:750;margin-top:4px;color:#FB7185;'>" & FORMAT([Taxa de Cancelamento], "0.00%", "pt-BR") & "</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #FBBF24;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>CICLO MÉDIO</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Tempo Ciclo Médio], "0.00", "pt-BR") & " min</div></div></div></div>"
		formatString: General
		displayFolder: HTML

	measure 'HTML | Etapas Operacionais' = "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#131D31;border:1px solid #2A3955;border-radius:12px;padding:14px;box-sizing:border-box;width:100%;height:100%;'><div style='font-size:12px;font-weight:700;margin-bottom:10px;'>DECOMPOSIÇÃO DO CICLO</div><div style='display:grid;grid-template-columns:1fr 1fr;gap:8px;'><div style='background:#1A2540;border-radius:8px;padding:10px;'><small style='color:#9FB0C7;'>Produção média</small><div style='font-size:17px;font-weight:700;margin-top:5px;'>" & FORMAT([Tempo Produção Médio], "0.00", "pt-BR") & " min</div></div><div style='background:#1A2540;border-radius:8px;padding:10px;'><small style='color:#9FB0C7;'>Trânsito médio</small><div style='font-size:17px;font-weight:700;margin-top:5px;'>" & FORMAT([Tempo Trânsito Médio], "0.00", "pt-BR") & " min</div></div><div style='background:#1A2540;border-radius:8px;padding:10px;'><small style='color:#9FB0C7;'>Ciclo P50</small><div style='font-size:17px;font-weight:700;margin-top:5px;'>" & FORMAT([Tempo Ciclo P50], "0.00", "pt-BR") & " min</div></div><div style='background:#1A2540;border-radius:8px;padding:10px;'><small style='color:#9FB0C7;'>Ciclo P90 · percentil</small><div style='font-size:17px;font-weight:700;margin-top:5px;color:#FBBF24;'>" & FORMAT([Tempo Ciclo P90], "0.00", "pt-BR") & " min</div></div></div></div>"
		formatString: General
		displayFolder: HTML

	measure 'HTML | KPIs Financeiros' = "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#131D31;border:1px solid #2A3955;border-radius:12px;padding:9px 12px;box-sizing:border-box;width:100%;height:100%;overflow:hidden;'><div style='font-size:11px;font-weight:700;margin-bottom:6px;'>FINANCEIRO E CONCILIAÇÃO</div><div style='display:flex;gap:8px;height:58px;'><div style='flex:1;background:#1A2540;border-left:4px solid #2DD4BF;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>VALOR PAGO</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Valor Pago], "R$ #,##0.00", "pt-BR") & "</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #4ADE80;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>CONCILIAÇÃO</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Taxa Conciliação], "0.00%", "pt-BR") & "</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #60A5FA;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>TRANSAÇÕES PAGAS</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Transações Pagas], "#,##0", "pt-BR") & "</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #FB7185;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>CHARGEBACK</small><div style='font-size:18px;font-weight:750;margin-top:4px;color:#FB7185;'>" & FORMAT([Valor Chargeback], "R$ #,##0.00", "pt-BR") & "</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #FBBF24;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>DIFERENÇA ABS.</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Diferença Absoluta Conciliação], "R$ #,##0.00", "pt-BR") & "</div></div></div></div>"
		formatString: General
		displayFolder: HTML

	measure 'HTML | KPIs Logística' = "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#131D31;border:1px solid #2A3955;border-radius:12px;padding:9px 12px;box-sizing:border-box;width:100%;height:100%;overflow:hidden;'><div style='font-size:11px;font-weight:700;margin-bottom:6px;'>ENTREGAS E QUALIDADE</div><div style='display:flex;gap:8px;height:58px;'><div style='flex:1;background:#1A2540;border-left:4px solid #2DD4BF;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>ENTREGA CONCLUÍDA</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Taxa Entrega Concluída], "0.00%", "pt-BR") & "</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #FB7185;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>MÚLTIPLAS TENTATIVAS</small><div style='font-size:18px;font-weight:750;margin-top:4px;color:#FB7185;'>" & FORMAT([Taxa Múltiplas Tentativas], "0.00%", "pt-BR") & "</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #3B82F6;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>CICLO P50</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Tempo Ciclo Logístico P50], "0.00", "pt-BR") & " min</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #FBBF24;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>CICLO P90 · PERCENTIL</small><div style='font-size:18px;font-weight:750;margin-top:4px;color:#FBBF24;'>" & FORMAT([Tempo Ciclo Logístico P90], "0.00", "pt-BR") & " min</div></div><div style='flex:1;background:#1A2540;border-left:4px solid #8B5CF6;border-radius:8px;padding:7px;'><small style='color:#9FB0C7;'>DISTÂNCIA MÉDIA</small><div style='font-size:18px;font-weight:750;margin-top:4px;'>" & FORMAT([Distância Média Entrega (km)], "0.00", "pt-BR") & " km</div></div></div></div>"
		formatString: General
		displayFolder: HTML

	measure 'HTML | Detalhe Pedido' = VAR PedidoId = SELECTEDVALUE(FatoDashboard[ID do Pedido]) VAR StatusPedido = SELECTEDVALUE(FatoDashboard[Status do Pedido], "Vários") VAR Loja = SELECTEDVALUE(FatoDashboard[Loja], "Várias") VAR Hub = SELECTEDVALUE(FatoDashboard[Hub], "Vários") RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#131D31;border:1px solid #2A3955;border-radius:12px;padding:11px 15px;box-sizing:border-box;width:100%;height:100%;'><div style='display:flex;align-items:center;justify-content:space-between;'><div><small style='color:#9FB0C7;letter-spacing:.07em;'>PEDIDO SELECIONADO</small><div style='font-size:22px;font-weight:800;margin-top:2px;'>#" & COALESCE(FORMAT(PedidoId, "0"), "—") & "</div></div><div style='background:#1A2540;border:1px solid #2A3955;border-radius:999px;padding:6px 11px;font-size:10px;font-weight:700;'>" & StatusPedido & "</div><div><small style='color:#9FB0C7;'>LOJA</small><div style='font-size:13px;font-weight:700;margin-top:3px;'>" & Loja & "</div></div><div><small style='color:#9FB0C7;'>HUB</small><div style='font-size:13px;font-weight:700;margin-top:3px;'>" & Hub & "</div></div><div><small style='color:#9FB0C7;'>VALOR / PAGO</small><div style='font-size:13px;font-weight:700;margin-top:3px;'>" & FORMAT([Valor Transacionado Finalizado], "R$ #,##0.00", "pt-BR") & " · " & FORMAT([Valor Pago], "R$ #,##0.00", "pt-BR") & "</div></div></div></div>"
		formatString: General
		displayFolder: HTML

	measure 'HTML | Tooltip Comercial' = VAR Contexto = [Contexto Tooltip] RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#090D18;border:1px solid #2A3955;border-radius:10px;padding:9px;box-sizing:border-box;width:100%;height:100%;overflow:hidden;'><div style='display:flex;justify-content:space-between;border-bottom:1px solid #2A3955;padding-bottom:7px;'><div><small style='color:#3B82F6;font-weight:700;'>DETALHE DO PONTO</small><div style='font-size:12px;font-weight:700;'>Desempenho comercial</div></div><small style='color:#9FB0C7;'>" & Contexto & "</small></div><div style='display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:7px;'><div style='background:#1A2540;border-left:3px solid #3B82F6;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Valor</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Valor Transacionado Finalizado], "R$ #,##0.00", "pt-BR") & "</div></div><div style='background:#1A2540;border-left:3px solid #3B82F6;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Mês anterior</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Valor Transacionado Mês Anterior], "R$ #,##0.00", "pt-BR") & "</div></div><div style='background:#1A2540;border-left:3px solid #8B5CF6;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Variação absoluta</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Variação Absoluta Valor Transacionado], "R$ #,##0.00", "pt-BR") & "</div></div><div style='background:#1A2540;border-left:3px solid #8B5CF6;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Variação percentual</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Variação Valor Transacionado Mensal], "0.00%", "pt-BR") & "</div></div><div style='grid-column:span 2;background:#1A2540;border-left:3px solid #22D3EE;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Participação no total</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Participação Valor Transacionado], "0.00%", "pt-BR") & "</div></div></div></div>"
		formatString: General
		displayFolder: HTML\Tooltips

	measure 'HTML | Tooltip Pedidos' = VAR Contexto = [Contexto Tooltip] RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#090D18;border:1px solid #2A3955;border-radius:10px;padding:9px;box-sizing:border-box;width:100%;height:100%;overflow:hidden;'><div style='display:flex;justify-content:space-between;border-bottom:1px solid #2A3955;padding-bottom:7px;'><div><small style='color:#22D3EE;font-weight:700;'>DETALHE DO PONTO</small><div style='font-size:12px;font-weight:700;'>Pedidos e operação</div></div><small style='color:#9FB0C7;'>" & Contexto & "</small></div><div style='display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:7px;'><div style='background:#1A2540;border-left:3px solid #22D3EE;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Pedidos</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Pedidos Criados], "#,##0", "pt-BR") & "</div></div><div style='background:#1A2540;border-left:3px solid #22D3EE;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Mês anterior</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Pedidos Mês Anterior], "#,##0", "pt-BR") & "</div></div><div style='background:#1A2540;border-left:3px solid #8B5CF6;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Variação absoluta</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Variação Absoluta Pedidos], "#,##0", "pt-BR") & "</div></div><div style='background:#1A2540;border-left:3px solid #8B5CF6;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Variação percentual</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Variação Pedidos Mensal], "0.00%", "pt-BR") & "</div></div><div style='grid-column:span 2;background:#1A2540;border-left:3px solid #3B82F6;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Participação no total</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Participação Pedidos], "0.00%", "pt-BR") & "</div></div></div></div>"
		formatString: General
		displayFolder: HTML\Tooltips

	measure 'HTML | Tooltip Financeiro' = VAR Contexto = [Contexto Tooltip] RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#090D18;border:1px solid #2A3955;border-radius:10px;padding:9px;box-sizing:border-box;width:100%;height:100%;overflow:hidden;'><div style='display:flex;justify-content:space-between;border-bottom:1px solid #2A3955;padding-bottom:7px;'><div><small style='color:#8B5CF6;font-weight:700;'>DETALHE DO PONTO</small><div style='font-size:12px;font-weight:700;'>Desempenho financeiro</div></div><small style='color:#9FB0C7;'>" & Contexto & "</small></div><div style='display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:7px;'><div style='background:#1A2540;border-left:3px solid #8B5CF6;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Valor pago</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Valor Pago], "R$ #,##0.00", "pt-BR") & "</div></div><div style='background:#1A2540;border-left:3px solid #8B5CF6;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Mês anterior</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Valor Pago Mês Anterior], "R$ #,##0.00", "pt-BR") & "</div></div><div style='background:#1A2540;border-left:3px solid #3B82F6;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Variação absoluta</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Variação Absoluta Valor Pago], "R$ #,##0.00", "pt-BR") & "</div></div><div style='background:#1A2540;border-left:3px solid #3B82F6;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Variação percentual</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Variação Valor Pago Mensal], "0.00%", "pt-BR") & "</div></div><div style='grid-column:span 2;background:#1A2540;border-left:3px solid #22D3EE;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Participação no total</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Participação Valor Pago], "0.00%", "pt-BR") & "</div></div></div></div>"
		formatString: General
		displayFolder: HTML\Tooltips

	measure 'HTML | Tooltip Entregas' = VAR Contexto = [Contexto Tooltip] RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#090D18;border:1px solid #2A3955;border-radius:10px;padding:9px;box-sizing:border-box;width:100%;height:100%;overflow:hidden;'><div style='display:flex;justify-content:space-between;border-bottom:1px solid #2A3955;padding-bottom:7px;'><div><small style='color:#FBBF24;font-weight:700;'>DETALHE DO PONTO</small><div style='font-size:12px;font-weight:700;'>Entregas e qualidade</div></div><small style='color:#9FB0C7;'>" & Contexto & "</small></div><div style='display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:7px;'><div style='background:#1A2540;border-left:3px solid #3B82F6;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Pedidos com entrega</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Pedidos com Entrega], "#,##0", "pt-BR") & "</div></div><div style='background:#1A2540;border-left:3px solid #22D3EE;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Entrega concluída</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Taxa Entrega Concluída], "0.00%", "pt-BR") & "</div></div><div style='background:#1A2540;border-left:3px solid #FB7185;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Múltiplas tentativas</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Taxa Múltiplas Tentativas], "0.00%", "pt-BR") & "</div></div><div style='background:#1A2540;border-left:3px solid #3B82F6;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Ciclo P50</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Tempo Ciclo Logístico P50], "0.00", "pt-BR") & " min</div></div><div style='background:#1A2540;border-left:3px solid #FBBF24;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Ciclo P90</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Tempo Ciclo Logístico P90], "0.00", "pt-BR") & " min</div></div><div style='background:#1A2540;border-left:3px solid #8B5CF6;border-radius:7px;padding:7px;'><small style='color:#9FB0C7;'>Participação no total</small><div style='font-size:14px;font-weight:750;'>" & FORMAT([Participação Pedidos com Entrega], "0.00%", "pt-BR") & "</div></div></div></div>"
		formatString: General
		displayFolder: HTML\Tooltips

	measure 'Entregas / Tentativas' = SUM(FatoDashboard[Número de Tentativas])
		formatString: #,##0
		displayFolder: Logística

	measure 'HTML | Painel Logística Dark' = VAR Taxa = [Taxa Entrega Concluída] VAR Angulo = FORMAT(Taxa * 360, "0.0", "en-US") RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F4F7FB;background:#081A28;border:1px solid #244052;border-radius:8px;padding:18px 26px;box-sizing:border-box;width:100%;height:100%;'><div style='font-size:18px;font-weight:700;margin-bottom:14px;'>Entregas concluídas</div><div style='width:205px;height:205px;margin:0 auto 14px;border-radius:50%;background:conic-gradient(#65D987 0deg " & Angulo & "deg,#183141 " & Angulo & "deg 360deg);display:flex;align-items:center;justify-content:center;'><div style='width:160px;height:160px;border-radius:50%;background:#081A28;display:flex;flex-direction:column;align-items:center;justify-content:center;'><div style='font-size:38px;font-weight:800;'>" & FORMAT(Taxa, "0.00%", "pt-BR") & "</div><small style='color:#A5B4C3;'>Entregas concluídas</small></div></div><div style='border-top:1px solid #244052;padding-top:12px;display:grid;grid-template-columns:1fr 1.7fr .5fr;row-gap:12px;align-items:center;'><b style='font-size:22px;color:#35C9F2;'>P50</b><b style='font-size:30px;'>" & FORMAT([Tempo Ciclo Logístico P50], "0.00", "pt-BR") & "</b><span>min</span><b style='font-size:22px;color:#35C9F2;'>P90</b><b style='font-size:30px;'>" & FORMAT([Tempo Ciclo Logístico P90], "0.00", "pt-BR") & "</b><span>min</span><b style='font-size:22px;color:#35C9F2;'>◫</b><b style='font-size:30px;'>" & FORMAT([Entregas / Tentativas], "#,##0", "pt-BR") & "</b><small style='color:#A5B4C3;'>tentativas</small></div></div>"
		formatString: General
		displayFolder: HTML\Dark

	measure 'HTML | Tabela Hubs Dark' = VAR Base = TOPN(5, ADDCOLUMNS(VALUES(FatoDashboard[Hub]), "__Entregas", [Pedidos com Entrega], "__Concluidas", [Entregas Concluídas], "__Taxa", [Taxa Entrega Concluída], "__P50", [Tempo Ciclo Logístico P50], "__Multi", [Taxa Múltiplas Tentativas]), [__Entregas], DESC) VAR MaxEntregas = MAXX(Base, [__Entregas]) VAR Linhas = CONCATENATEX(Base, "<div style='display:grid;grid-template-columns:1.35fr 1.05fr 1.15fr .8fr 1fr;gap:14px;align-items:center;padding:11px 14px;border-top:1px solid #244052;'><div style='font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'><span style='color:" & IF([__Taxa] >= .97, "#65D987", "#FFC244") & ";margin-right:9px;'>●</span>" & FatoDashboard[Hub] & "</div><div><b>" & FORMAT([__Entregas], "#,##0", "pt-BR") & "</b><div style='height:7px;background:#25394A;border-radius:8px;margin-top:5px;'><div style='height:7px;width:" & FORMAT(DIVIDE([__Entregas], MaxEntregas), "0%", "en-US") & ";background:#35C9F2;border-radius:8px;'></div></div></div><div><b>" & FORMAT([__Concluidas], "#,##0", "pt-BR") & "</b><div style='height:7px;background:#25394A;border-radius:8px;margin-top:5px;'><div style='height:7px;width:" & FORMAT([__Taxa], "0%", "en-US") & ";background:#65D987;border-radius:8px;'></div></div></div><div style='color:#35C9F2;font-size:17px;font-weight:700;'>" & FORMAT([__P50], "0.00", "pt-BR") & "</div><div style='color:" & IF([__Multi] <= .07, "#65D987", "#FFC244") & ";font-weight:700;'>" & FORMAT([__Multi], "0.00%", "pt-BR") & "</div></div>", "", [__Entregas], DESC) RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F4F7FB;background:#081A28;border:1px solid #244052;border-radius:8px;padding:14px;box-sizing:border-box;width:100%;height:100%;overflow:hidden;'><div style='display:flex;justify-content:space-between;align-items:flex-start;margin:0 10px 12px;'><div style='font-size:20px;font-weight:750;'>Desempenho por hub</div><div style='display:flex;gap:44px;'><div><small style='color:#A5B4C3;'>Taxa de cancelamento</small><div style='font-size:25px;font-weight:800;'>" & FORMAT([Taxa de Cancelamento], "0.00%", "pt-BR") & "</div></div><div><small style='color:#A5B4C3;'>Margem de entrega</small><div style='font-size:25px;font-weight:800;color:#FF7A6E;'>" & FORMAT([Margem de Entrega], "R$ #,##0.00", "pt-BR") & "</div></div></div></div><div style='display:grid;grid-template-columns:1.35fr 1.05fr 1.15fr .8fr 1fr;gap:14px;padding:8px 14px;color:#A5B4C3;font-size:11px;text-transform:uppercase;'><span>Hub</span><span>Entregas</span><span>Concluídas</span><span>P50 (min)</span><span>Múltiplas tentativas</span></div>" & Linhas & "</div>"
		formatString: General
		displayFolder: HTML\Dark

	measure 'HTML | Margem Light' = VAR Cor = IF([Margem de Entrega] >= 0, "#14B8A6", "#FF5A52") RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;color:#0B1B38;background:#FFFFFF;border:1px solid #D8DEE8;border-radius:10px;padding:18px;box-sizing:border-box;width:100%;height:100%;'><div style='font-size:17px;font-weight:750;'>Margem de entrega</div><div style='font-size:34px;font-weight:800;color:" & Cor & ";margin-top:40px;'>" & FORMAT([Margem de Entrega], "R$ #,##0.00", "pt-BR") & "</div><div style='height:2px;background:" & Cor & ";margin-top:14px;'></div><div style='font-size:11px;color:#596579;margin-top:12px;'>taxas de entrega × custo de entrega</div></div>"
		formatString: General
		displayFolder: HTML\Light

	measure 'HTML | Ciclo Light' = VAR P50 = [Tempo Ciclo Logístico P50] VAR P90 = [Tempo Ciclo Logístico P90] RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;color:#0B1B38;background:#FFFFFF;border:1px solid #D8DEE8;border-radius:10px;padding:18px;box-sizing:border-box;width:100%;height:100%;'><div style='font-size:17px;font-weight:750;margin-bottom:26px;'>Tempo de ciclo</div><div style='display:grid;grid-template-columns:58px 115px 1fr;gap:12px;align-items:center;margin-bottom:42px;'><b style='color:#14B8A6;font-size:18px;'>P50</b><b style='font-size:22px;color:#14B8A6;'>" & FORMAT(P50, "0.00", "pt-BR") & " min</b><div style='height:8px;background:#E6EBF2;border-radius:8px;'><div style='height:8px;width:" & FORMAT(DIVIDE(P50, 180), "0%", "en-US") & ";background:#14B8A6;border-radius:8px;'></div></div><b style='color:#2563EB;font-size:18px;'>P90</b><b style='font-size:22px;color:#2563EB;'>" & FORMAT(P90, "0.00", "pt-BR") & " min</b><div style='height:8px;background:#E6EBF2;border-radius:8px;'><div style='height:8px;width:" & FORMAT(DIVIDE(P90, 180), "0%", "en-US") & ";background:#2563EB;border-radius:8px;'></div></div></div></div>"
		formatString: General
		displayFolder: HTML\Light

	measure 'HTML | KPIs Executivos Light' = VAR Html = [HTML | KPIs Executivos] RETURN SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Html, "#F8FAFC", "#0B1B38"), "#131D31", "#FFFFFF"), "#1A2540", "#F5F7FB"), "#2A3955", "#D8DEE8"), "#9FB0C7", "#596579")
		formatString: General
		displayFolder: HTML\Light

	measure 'HTML | KPIs Pedidos Light' = VAR Html = [HTML | KPIs Pedidos] RETURN SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Html, "#F8FAFC", "#0B1B38"), "#131D31", "#FFFFFF"), "#1A2540", "#F5F7FB"), "#2A3955", "#D8DEE8"), "#9FB0C7", "#596579")
		formatString: General
		displayFolder: HTML\Light

	measure 'HTML | Etapas Operacionais Light' = VAR Html = [HTML | Etapas Operacionais] RETURN SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Html, "#F8FAFC", "#0B1B38"), "#131D31", "#FFFFFF"), "#1A2540", "#F5F7FB"), "#2A3955", "#D8DEE8"), "#9FB0C7", "#596579")
		formatString: General
		displayFolder: HTML\Light

	measure 'HTML | KPIs Financeiros Light' = VAR Html = [HTML | KPIs Financeiros] RETURN SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Html, "#F8FAFC", "#0B1B38"), "#131D31", "#FFFFFF"), "#1A2540", "#F5F7FB"), "#2A3955", "#D8DEE8"), "#9FB0C7", "#596579")
		formatString: General
		displayFolder: HTML\Light

	measure 'HTML | KPIs Logística Light' = VAR Html = [HTML | KPIs Logística] RETURN SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Html, "#F8FAFC", "#0B1B38"), "#131D31", "#FFFFFF"), "#1A2540", "#F5F7FB"), "#2A3955", "#D8DEE8"), "#9FB0C7", "#596579")
		formatString: General
		displayFolder: HTML\Light

	measure 'HTML | Detalhe Pedido Light' = VAR Html = [HTML | Detalhe Pedido] RETURN SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Html, "#F8FAFC", "#0B1B38"), "#131D31", "#FFFFFF"), "#1A2540", "#F5F7FB"), "#2A3955", "#D8DEE8"), "#9FB0C7", "#596579")
		formatString: General
		displayFolder: HTML\Light

	measure 'HTML | Tooltip Comercial Light' = VAR Html = [HTML | Tooltip Comercial] RETURN SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Html, "#F8FAFC", "#0B1B38"), "#090D18", "#FFFFFF"), "#1A2540", "#F5F7FB"), "#2A3955", "#D8DEE8"), "#9FB0C7", "#596579"), "#F4F7FB", "#0B1B38")
		formatString: General
		displayFolder: HTML\Light\Tooltips

	measure 'HTML | Tooltip Pedidos Light' = VAR Html = [HTML | Tooltip Pedidos] RETURN SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Html, "#F8FAFC", "#0B1B38"), "#090D18", "#FFFFFF"), "#1A2540", "#F5F7FB"), "#2A3955", "#D8DEE8"), "#9FB0C7", "#596579"), "#F4F7FB", "#0B1B38")
		formatString: General
		displayFolder: HTML\Light\Tooltips

	measure 'HTML | Tooltip Financeiro Light' = VAR Html = [HTML | Tooltip Financeiro] RETURN SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Html, "#F8FAFC", "#0B1B38"), "#090D18", "#FFFFFF"), "#1A2540", "#F5F7FB"), "#2A3955", "#D8DEE8"), "#9FB0C7", "#596579"), "#F4F7FB", "#0B1B38")
		formatString: General
		displayFolder: HTML\Light\Tooltips

	measure 'HTML | Tooltip Entregas Light' = VAR Html = [HTML | Tooltip Entregas] RETURN SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Html, "#F8FAFC", "#0B1B38"), "#090D18", "#FFFFFF"), "#1A2540", "#F5F7FB"), "#2A3955", "#D8DEE8"), "#9FB0C7", "#596579"), "#F4F7FB", "#0B1B38")
		formatString: General
		displayFolder: HTML\Light\Tooltips

