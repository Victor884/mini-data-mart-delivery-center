/// Dimensão de hubs logísticos; uma linha por hub.
table Hubs

	column 'Chave Hub'
		dataType: int64
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: hub_id

	column Hub
		dataType: string
		sourceColumn: hub_name

	column 'Cidade Hub'
		dataType: string
		dataCategory: City
		sourceColumn: hub_city

	column 'UF Hub'
		dataType: string
		dataCategory: StateOrProvince
		sourceColumn: hub_state

	partition Hubs = m
		mode: import
		source =
			let
				Fonte = PostgreSQL.Database(#"Servidor PostgreSQL", #"Banco PostgreSQL", [Query = "SELECT DISTINCT hub_id, hub_name, hub_city, hub_state FROM mart.vw_pedidos_enriquecidos"])
			in
				Fonte
