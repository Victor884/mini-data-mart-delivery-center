/// Dimensão de entregadores; uma linha por entregador, incluindo o membro não informado.
table Entregadores

	column 'Chave Entregador'
		dataType: int64
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: driver_id

	column 'Modal Entregador'
		dataType: string
		sourceColumn: driver_modal

	column 'Tipo Entregador'
		dataType: string
		sourceColumn: driver_type

	partition Entregadores = m
		mode: import
		source =
			let
				Fonte = PostgreSQL.Database(#"Servidor PostgreSQL", #"Banco PostgreSQL", [Query = "SELECT DISTINCT driver_id, driver_modal, driver_type FROM mart.vw_entregas_enriquecidas"])
			in
				Fonte
