/// Tabela utilitária que centraliza todas as medidas explícitas do modelo.
table 'Métricas'

	/// Quantidade de pedidos no contexto de filtro.
	measure 'Pedidos Criados' = ```
			COUNTROWS('Pedidos')
		```
		formatString: #,##0
		displayFolder: "01 Comercial"

	/// Pedidos com status FINISHED.
	measure 'Pedidos Finalizados' = ```
			CALCULATE([Pedidos Criados], KEEPFILTERS('Pedidos'[Status Pedido] = "FINISHED"))
		```
		formatString: #,##0
		displayFolder: "01 Comercial"

	/// Pedidos com status CANCELED.
	measure 'Pedidos Cancelados' = ```
			CALCULATE([Pedidos Criados], KEEPFILTERS('Pedidos'[Status Pedido] = "CANCELED"))
		```
		formatString: #,##0
		displayFolder: "01 Comercial"

	/// Pedidos cancelados divididos por pedidos criados; nunca é média de percentuais.
	measure 'Taxa Cancelamento' = ```
			DIVIDE([Pedidos Cancelados], [Pedidos Criados])
		```
		formatString: 0.00%
		displayFolder: "01 Comercial"

	/// Soma do valor total de pedidos finalizados.
	measure 'Valor Transacionado' = ```
			CALCULATE(SUM('Pedidos'[Valor Total Pedido]), KEEPFILTERS('Pedidos'[Status Pedido] = "FINISHED"))
		```
		formatString: R$ #,##0.00
		displayFolder: "01 Comercial"

	/// Valor transacionado dividido por pedidos finalizados.
	measure 'Ticket Médio' = ```
			DIVIDE([Valor Transacionado], [Pedidos Finalizados])
		```
		formatString: R$ #,##0.00
		displayFolder: "01 Comercial"

	/// Taxas de entrega cobradas em pedidos finalizados.
	measure 'Taxas de Entrega' = ```
			CALCULATE(SUM('Pedidos'[Taxa Entrega]), KEEPFILTERS('Pedidos'[Status Pedido] = "FINISHED"))
		```
		formatString: R$ #,##0.00
		displayFolder: "01 Comercial"

	/// Custo logístico de pedidos finalizados.
	measure 'Custo de Entrega' = ```
			CALCULATE(SUM('Pedidos'[Custo Entrega]), KEEPFILTERS('Pedidos'[Status Pedido] = "FINISHED"))
		```
		formatString: R$ #,##0.00
		displayFolder: "01 Comercial"

	/// Taxa de entrega menos custo de entrega nos pedidos finalizados.
	measure 'Margem Entrega' = ```
			CALCULATE(SUM('Pedidos'[Margem Entrega]), KEEPFILTERS('Pedidos'[Status Pedido] = "FINISHED"))
		```
		formatString: R$ #,##0.00
		displayFolder: "01 Comercial"

	/// Margem de entrega dividida pelas taxas de entrega cobradas.
	measure 'Margem sobre Taxa Entrega' = ```
			DIVIDE([Margem Entrega], [Taxas de Entrega])
		```
		formatString: 0.00%
		displayFolder: "01 Comercial"

	/// Valor transacionado deslocado em um mês.
	measure 'Valor Transacionado Mês Anterior' = ```
			CALCULATE([Valor Transacionado], DATEADD('Calendário'[Data], -1, MONTH))
		```
		formatString: R$ #,##0.00
		displayFolder: "01 Comercial\Inteligência de Tempo"

	/// Variação do valor transacionado contra o mês anterior.
	measure 'Variação Valor Mensal' = ```
			DIVIDE([Valor Transacionado] - [Valor Transacionado Mês Anterior], [Valor Transacionado Mês Anterior])
		```
		formatString: 0.00%
		displayFolder: "01 Comercial\Inteligência de Tempo"

	/// Pedidos representados pela última tentativa de entrega.
	measure 'Pedidos com Entrega' = ```
			CALCULATE(DISTINCTCOUNT('Entregas'[Chave Pedido]), KEEPFILTERS('Entregas'[É Última Tentativa] = TRUE()))
		```
		formatString: #,##0
		displayFolder: "02 Logística"

	/// Últimas tentativas com status DELIVERED.
	measure 'Entregas Concluídas' = ```
			CALCULATE(DISTINCTCOUNT('Entregas'[Chave Pedido]), KEEPFILTERS('Entregas'[É Última Tentativa] = TRUE()), KEEPFILTERS('Entregas'[Status Entrega] = "DELIVERED"))
		```
		formatString: #,##0
		displayFolder: "02 Logística"

	/// Entregas concluídas divididas por pedidos com entrega.
	measure 'Taxa Entrega Concluída' = ```
			DIVIDE([Entregas Concluídas], [Pedidos com Entrega])
		```
		formatString: 0.00%
		displayFolder: "02 Logística"

	/// Pedidos cuja última tentativa tem número maior que um.
	measure 'Pedidos Múltiplas Tentativas' = ```
			CALCULATE(DISTINCTCOUNT('Entregas'[Chave Pedido]), KEEPFILTERS('Entregas'[É Última Tentativa] = TRUE()), KEEPFILTERS('Entregas'[Número Tentativa] > 1))
		```
		formatString: #,##0
		displayFolder: "02 Logística"

	/// Pedidos com múltiplas tentativas divididos por pedidos com entrega.
	measure 'Taxa Múltiplas Tentativas' = ```
			DIVIDE([Pedidos Múltiplas Tentativas], [Pedidos com Entrega])
		```
		formatString: 0.00%
		displayFolder: "02 Logística"

	/// Distância média em quilômetros de últimas tentativas entregues com distância informada.
	measure 'Distância Média Entrega (km)' = ```
			DIVIDE(CALCULATE(AVERAGE('Entregas'[Distância Entrega (m)]), KEEPFILTERS('Entregas'[É Última Tentativa] = TRUE()), KEEPFILTERS('Entregas'[Status Entrega] = "DELIVERED")), 1000)
		```
		formatString: #,##0.00
		displayFolder: "02 Logística"

	/// Tempo médio dos pedidos finalizados; ao filtrar entregadores, restringe aos pedidos das últimas tentativas selecionadas.
	measure 'Tempo Ciclo Médio' = ```
			VAR PedidosEntrega = CALCULATETABLE(VALUES('Entregas'[Chave Pedido]), KEEPFILTERS('Entregas'[É Última Tentativa] = TRUE())) RETURN IF(ISCROSSFILTERED('Entregadores'), CALCULATE(AVERAGEX(FILTER('Pedidos', 'Pedidos'[Status Pedido] = "FINISHED" && 'Pedidos'[Tempo Ciclo] >= 0), 'Pedidos'[Tempo Ciclo]), TREATAS(PedidosEntrega, 'Pedidos'[Chave Pedido])), AVERAGEX(FILTER('Pedidos', 'Pedidos'[Status Pedido] = "FINISHED" && 'Pedidos'[Tempo Ciclo] >= 0), 'Pedidos'[Tempo Ciclo]))
		```
		formatString: #,##0.00
		displayFolder: "02 Logística"

	/// Percentil 50 dos pedidos finalizados; ao filtrar entregadores, restringe aos pedidos das últimas tentativas selecionadas.
	measure 'Tempo Ciclo P50' = ```
			VAR PedidosEntrega = CALCULATETABLE(VALUES('Entregas'[Chave Pedido]), KEEPFILTERS('Entregas'[É Última Tentativa] = TRUE())) RETURN IF(ISCROSSFILTERED('Entregadores'), CALCULATE(PERCENTILEX.INC(FILTER('Pedidos', 'Pedidos'[Status Pedido] = "FINISHED" && 'Pedidos'[Tempo Ciclo] >= 0), 'Pedidos'[Tempo Ciclo], 0.5), TREATAS(PedidosEntrega, 'Pedidos'[Chave Pedido])), PERCENTILEX.INC(FILTER('Pedidos', 'Pedidos'[Status Pedido] = "FINISHED" && 'Pedidos'[Tempo Ciclo] >= 0), 'Pedidos'[Tempo Ciclo], 0.5))
		```
		formatString: #,##0.00
		displayFolder: "02 Logística"

	/// Percentil 90 dos pedidos finalizados; ao filtrar entregadores, restringe aos pedidos das últimas tentativas selecionadas.
	measure 'Tempo Ciclo P90' = ```
			VAR PedidosEntrega = CALCULATETABLE(VALUES('Entregas'[Chave Pedido]), KEEPFILTERS('Entregas'[É Última Tentativa] = TRUE())) RETURN IF(ISCROSSFILTERED('Entregadores'), CALCULATE(PERCENTILEX.INC(FILTER('Pedidos', 'Pedidos'[Status Pedido] = "FINISHED" && 'Pedidos'[Tempo Ciclo] >= 0), 'Pedidos'[Tempo Ciclo], 0.9), TREATAS(PedidosEntrega, 'Pedidos'[Chave Pedido])), PERCENTILEX.INC(FILTER('Pedidos', 'Pedidos'[Status Pedido] = "FINISHED" && 'Pedidos'[Tempo Ciclo] >= 0), 'Pedidos'[Tempo Ciclo], 0.9))
		```
		formatString: #,##0.00
		displayFolder: "02 Logística"

	/// Quantidade de transações com status PAID.
	measure 'Transações Pagas' = ```
			CALCULATE(COUNTROWS('Pagamentos'), KEEPFILTERS('Pagamentos'[Status Pagamento] = "PAID"))
		```
		formatString: #,##0
		displayFolder: "03 Financeiro"

	/// Valor bruto de transações PAID.
	measure 'Valor Pago' = ```
			CALCULATE(SUM('Pagamentos'[Valor Pagamento]), KEEPFILTERS('Pagamentos'[Status Pagamento] = "PAID"))
		```
		formatString: R$ #,##0.00
		displayFolder: "03 Financeiro"

	/// Taxas das transações PAID.
	measure 'Taxas Pagamento' = ```
			CALCULATE(SUM('Pagamentos'[Taxa Pagamento]), KEEPFILTERS('Pagamentos'[Status Pagamento] = "PAID"))
		```
		formatString: R$ #,##0.00
		displayFolder: "03 Financeiro"

	/// Valor líquido das transações PAID.
	measure 'Valor Líquido Pago' = ```
			CALCULATE(SUM('Pagamentos'[Valor Líquido Pagamento]), KEEPFILTERS('Pagamentos'[Status Pagamento] = "PAID"))
		```
		formatString: R$ #,##0.00
		displayFolder: "03 Financeiro"

	/// Quantidade de transações em chargeback.
	measure Chargebacks = ```
			CALCULATE(COUNTROWS('Pagamentos'), KEEPFILTERS('Pagamentos'[Status Pagamento] = "CHARGEBACK"))
		```
		formatString: #,##0
		displayFolder: "03 Financeiro"

	/// Valor bruto das transações em chargeback.
	measure 'Valor Chargeback' = ```
			CALCULATE(SUM('Pagamentos'[Valor Pagamento]), KEEPFILTERS('Pagamentos'[Status Pagamento] = "CHARGEBACK"))
		```
		formatString: R$ #,##0.00
		displayFolder: "03 Financeiro"

	/// Pedidos no contexto da view de conciliação.
	measure 'Pedidos na Conciliação' = ```
			DISTINCTCOUNT('Conciliação'[Chave Pedido])
		```
		formatString: #,##0
		displayFolder: "03 Financeiro"

	/// Pedidos finalizados classificados como conciliados.
	measure 'Pedidos Conciliados' = ```
			CALCULATE([Pedidos na Conciliação], KEEPFILTERS('Conciliação'[Status Pedido] = "FINISHED"), KEEPFILTERS('Conciliação'[Status Conciliação] = "CONCILIADO"))
		```
		formatString: #,##0
		displayFolder: "03 Financeiro"

	/// Denominador da taxa de conciliação: pedidos finalizados.
	measure 'Pedidos Finalizados Conciliação' = ```
			CALCULATE([Pedidos na Conciliação], KEEPFILTERS('Conciliação'[Status Pedido] = "FINISHED"))
		```
		formatString: #,##0
		displayFolder: "03 Financeiro"

	/// Pedidos finalizados conciliados divididos pelos pedidos finalizados.
	measure 'Taxa Conciliação' = ```
			DIVIDE([Pedidos Conciliados], [Pedidos Finalizados Conciliação])
		```
		formatString: 0.00%
		displayFolder: "03 Financeiro"

	/// Soma do valor absoluto das diferenças dos pedidos finalizados.
	measure 'Diferença Absoluta Conciliação' = ```
			CALCULATE(SUMX('Conciliação', ABS('Conciliação'[Diferença Conciliação])), KEEPFILTERS('Conciliação'[Status Pedido] = "FINISHED"))
		```
		formatString: R$ #,##0.00
		displayFolder: "03 Financeiro"

	/// Pedidos finalizados sem transação PAID.
	measure 'Pedidos sem Pagamento Pago' = ```
			CALCULATE([Pedidos na Conciliação], KEEPFILTERS('Conciliação'[Status Pedido] = "FINISHED"), KEEPFILTERS('Conciliação'[Status Conciliação] IN { "SEM_PAGAMENTO", "SEM_PAGAMENTO_PAGO" }))
		```
		formatString: #,##0
		displayFolder: "03 Financeiro"

	/// Painel HTML/CSS com os KPIs comerciais principais.
	measure 'HTML | KPIs Executivos' = ```
			VAR Periodo = FORMAT(MIN('Calendário'[Data]), "dd/MM/yyyy") & " a " & FORMAT(MAX('Calendário'[Data]), "dd/MM/yyyy")
			VAR CorMargem = IF([Margem Entrega] >= 0, "#4ADE80", "#FB7185")
			RETURN
			"<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#101B2D;border:1px solid #263A56;border-radius:14px;padding:14px 16px;box-sizing:border-box;width:100%;height:100%;'>" &
			"<div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;'><div style='font-size:13px;font-weight:700;letter-spacing:.04em;'>VISÃO EXECUTIVA</div><div style='font-size:10px;color:#9FB0C7;'>" & Periodo & "</div></div>" &
			"<div style='display:flex;gap:10px;height:86px;'>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid #2DD4BF;border-radius:10px;padding:10px;box-sizing:border-box;'><div style='font-size:10px;color:#9FB0C7;'>VALOR TRANSACIONADO</div><div style='font-size:22px;font-weight:750;margin-top:7px;'>" & FORMAT([Valor Transacionado], "R$ #,##0.00", "pt-BR") & "</div></div>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid #60A5FA;border-radius:10px;padding:10px;box-sizing:border-box;'><div style='font-size:10px;color:#9FB0C7;'>PEDIDOS FINALIZADOS</div><div style='font-size:22px;font-weight:750;margin-top:7px;'>" & FORMAT([Pedidos Finalizados], "#,##0", "pt-BR") & "</div></div>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid #A78BFA;border-radius:10px;padding:10px;box-sizing:border-box;'><div style='font-size:10px;color:#9FB0C7;'>TICKET MÉDIO</div><div style='font-size:22px;font-weight:750;margin-top:7px;'>" & FORMAT([Ticket Médio], "R$ #,##0.00", "pt-BR") & "</div></div>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid #FBBF24;border-radius:10px;padding:10px;box-sizing:border-box;'><div style='font-size:10px;color:#9FB0C7;'>CANCELAMENTO</div><div style='font-size:22px;font-weight:750;margin-top:7px;'>" & FORMAT([Taxa Cancelamento], "0.00%", "pt-BR") & "</div></div>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid " & CorMargem & ";border-radius:10px;padding:10px;box-sizing:border-box;'><div style='font-size:10px;color:#9FB0C7;'>MARGEM ENTREGA</div><div style='font-size:22px;font-weight:750;margin-top:7px;color:" & CorMargem & ";'>" & FORMAT([Margem Entrega], "R$ #,##0.00", "pt-BR") & "</div></div>" &
			"</div></div>"
		```
		formatString: General
		displayFolder: "90 HTML"

	/// Ranking HTML/CSS dos cinco hubs com maior valor transacionado.
	measure 'HTML | Ranking Hubs' = ```
			VAR Base = FILTER(ADDCOLUMNS(VALUES('Hubs'[Hub]), "Valor", [Valor Transacionado]), NOT ISBLANK('Hubs'[Hub]))
			VAR TopHubs = TOPN(5, Base, [Valor], DESC, 'Hubs'[Hub], ASC)
			VAR Maximo = MAXX(TopHubs, [Valor])
			VAR Linhas = CONCATENATEX(TopHubs, "<div style='margin-top:10px;'><div style='display:flex;justify-content:space-between;font-size:11px;'><span>" & 'Hubs'[Hub] & "</span><span style='color:#9FB0C7;'>" & FORMAT([Valor], "R$ #,##0", "pt-BR") & "</span></div><div style='height:7px;background:#263A56;border-radius:7px;margin-top:4px;overflow:hidden;'><div style='height:7px;width:" & FORMAT(DIVIDE([Valor], Maximo), "0.0%", "en-US") & ";background:linear-gradient(90deg,#2DD4BF,#60A5FA);border-radius:7px;'></div></div></div>", "", [Valor], DESC)
			RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#101B2D;border:1px solid #263A56;border-radius:14px;padding:15px 18px;box-sizing:border-box;width:100%;height:100%;'><div style='font-size:13px;font-weight:700;'>TOP 5 HUBS POR VALOR</div><div style='font-size:10px;color:#9FB0C7;margin-top:2px;'>Responde aos filtros da página</div>" & Linhas & "</div>"
		```
		formatString: General
		displayFolder: "90 HTML"

	/// Painel HTML/CSS com os KPIs logísticos principais.
	measure 'HTML | KPIs Logística' = ```
			RETURN
			"<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#101B2D;border:1px solid #263A56;border-radius:14px;padding:14px 16px;box-sizing:border-box;width:100%;height:100%;'>" &
			"<div style='font-size:13px;font-weight:700;letter-spacing:.04em;margin-bottom:10px;'>PERFORMANCE LOGÍSTICA</div><div style='display:flex;gap:10px;height:86px;'>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid #4ADE80;border-radius:10px;padding:10px;'><div style='font-size:10px;color:#9FB0C7;'>ENTREGA CONCLUÍDA</div><div style='font-size:22px;font-weight:750;margin-top:7px;'>" & FORMAT([Taxa Entrega Concluída], "0.00%", "pt-BR") & "</div></div>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid #FBBF24;border-radius:10px;padding:10px;'><div style='font-size:10px;color:#9FB0C7;'>MÚLTIPLAS TENTATIVAS</div><div style='font-size:22px;font-weight:750;margin-top:7px;'>" & FORMAT([Taxa Múltiplas Tentativas], "0.00%", "pt-BR") & "</div></div>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid #2DD4BF;border-radius:10px;padding:10px;'><div style='font-size:10px;color:#9FB0C7;'>CICLO P50</div><div style='font-size:22px;font-weight:750;margin-top:7px;'>" & FORMAT([Tempo Ciclo P50], "0.00", "pt-BR") & " min</div></div>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid #A78BFA;border-radius:10px;padding:10px;'><div style='font-size:10px;color:#9FB0C7;'>CICLO P90</div><div style='font-size:22px;font-weight:750;margin-top:7px;'>" & FORMAT([Tempo Ciclo P90], "0.00", "pt-BR") & " min</div></div>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid #60A5FA;border-radius:10px;padding:10px;'><div style='font-size:10px;color:#9FB0C7;'>DISTÂNCIA MÉDIA</div><div style='font-size:22px;font-weight:750;margin-top:7px;'>" & FORMAT([Distância Média Entrega (km)], "0.00", "pt-BR") & " km</div></div>" &
			"</div></div>"
		```
		formatString: General
		displayFolder: "90 HTML"

	/// Ranking HTML/CSS dos hubs com maior taxa de múltiplas tentativas.
	measure 'HTML | Ranking Tentativas' = ```
			VAR Base = FILTER(ADDCOLUMNS(VALUES('Hubs'[Hub]), "Taxa", [Taxa Múltiplas Tentativas]), NOT ISBLANK('Hubs'[Hub]))
			VAR TopHubs = TOPN(5, Base, [Taxa], DESC, 'Hubs'[Hub], ASC)
			VAR Maximo = MAXX(TopHubs, [Taxa])
			VAR Linhas = CONCATENATEX(TopHubs, "<div style='margin-top:10px;'><div style='display:flex;justify-content:space-between;font-size:11px;'><span>" & 'Hubs'[Hub] & "</span><span style='color:#9FB0C7;'>" & FORMAT([Taxa], "0.00%", "pt-BR") & "</span></div><div style='height:7px;background:#263A56;border-radius:7px;margin-top:4px;overflow:hidden;'><div style='height:7px;width:" & FORMAT(DIVIDE([Taxa], Maximo), "0.0%", "en-US") & ";background:linear-gradient(90deg,#FBBF24,#FB7185);border-radius:7px;'></div></div></div>", "", [Taxa], DESC)
			RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#101B2D;border:1px solid #263A56;border-radius:14px;padding:15px 18px;box-sizing:border-box;width:100%;height:100%;'><div style='font-size:13px;font-weight:700;'>HUBS COM MAIS RETENTATIVAS</div><div style='font-size:10px;color:#9FB0C7;margin-top:2px;'>Última tentativa registrada por pedido</div>" & Linhas & "</div>"
		```
		formatString: General
		displayFolder: "90 HTML"

	/// Painel HTML/CSS com os KPIs financeiros e de conciliação.
	measure 'HTML | KPIs Financeiros' = ```
			RETURN
			"<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#101B2D;border:1px solid #263A56;border-radius:14px;padding:14px 16px;box-sizing:border-box;width:100%;height:100%;'>" &
			"<div style='font-size:13px;font-weight:700;letter-spacing:.04em;margin-bottom:10px;'>FINANCEIRO E CONCILIAÇÃO</div><div style='display:flex;gap:10px;height:86px;'>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid #2DD4BF;border-radius:10px;padding:10px;'><div style='font-size:10px;color:#9FB0C7;'>VALOR PAGO</div><div style='font-size:22px;font-weight:750;margin-top:7px;'>" & FORMAT([Valor Pago], "R$ #,##0.00", "pt-BR") & "</div></div>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid #4ADE80;border-radius:10px;padding:10px;'><div style='font-size:10px;color:#9FB0C7;'>CONCILIAÇÃO</div><div style='font-size:22px;font-weight:750;margin-top:7px;'>" & FORMAT([Taxa Conciliação], "0.00%", "pt-BR") & "</div></div>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid #60A5FA;border-radius:10px;padding:10px;'><div style='font-size:10px;color:#9FB0C7;'>TRANSAÇÕES PAGAS</div><div style='font-size:22px;font-weight:750;margin-top:7px;'>" & FORMAT([Transações Pagas], "#,##0", "pt-BR") & "</div></div>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid #FB7185;border-radius:10px;padding:10px;'><div style='font-size:10px;color:#9FB0C7;'>CHARGEBACK</div><div style='font-size:22px;font-weight:750;margin-top:7px;'>" & FORMAT([Valor Chargeback], "R$ #,##0.00", "pt-BR") & "</div></div>" &
			"<div style='flex:1;background:#15233A;border-top:3px solid #FBBF24;border-radius:10px;padding:10px;'><div style='font-size:10px;color:#9FB0C7;'>DIFERENÇA ABSOLUTA</div><div style='font-size:22px;font-weight:750;margin-top:7px;'>" & FORMAT([Diferença Absoluta Conciliação], "R$ #,##0.00", "pt-BR") & "</div></div>" &
			"</div></div>"
		```
		formatString: General
		displayFolder: "90 HTML"

	/// Distribuição HTML/CSS dos pedidos por status de conciliação.
	measure 'HTML | Status Conciliação' = ```
			VAR Base = FILTER(ADDCOLUMNS(VALUES('Conciliação'[Status Conciliação]), "Pedidos", [Pedidos na Conciliação]), NOT ISBLANK('Conciliação'[Status Conciliação]))
			VAR TotalPedidos = SUMX(Base, [Pedidos])
			VAR Linhas = CONCATENATEX(Base, "<div style='margin-top:9px;'><div style='display:flex;justify-content:space-between;font-size:10px;'><span>" & SUBSTITUTE('Conciliação'[Status Conciliação], "_", " ") & "</span><span style='color:#9FB0C7;'>" & FORMAT([Pedidos], "#,##0", "pt-BR") & " · " & FORMAT(DIVIDE([Pedidos], TotalPedidos), "0.0%", "pt-BR") & "</span></div><div style='height:6px;background:#263A56;border-radius:6px;margin-top:3px;overflow:hidden;'><div style='height:6px;width:" & FORMAT(DIVIDE([Pedidos], TotalPedidos), "0.0%", "en-US") & ";background:#A78BFA;border-radius:6px;'></div></div></div>", "", [Pedidos], DESC)
			RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#101B2D;border:1px solid #263A56;border-radius:14px;padding:15px 18px;box-sizing:border-box;width:100%;height:100%;'><div style='font-size:13px;font-weight:700;'>STATUS DE CONCILIAÇÃO</div><div style='font-size:10px;color:#9FB0C7;margin-top:2px;'>Uma linha por pedido, sem fanout de pagamentos</div>" & Linhas & "</div>"
		```
		formatString: General
		displayFolder: "90 HTML"

	/// Cabeçalho HTML/CSS do pedido selecionado via drill-through.
	measure 'HTML | Detalhe Pedido' = ```
			VAR PedidoId = SELECTEDVALUE('Pedido'[Pedido ID])
			VAR StatusPedido = SELECTEDVALUE('Pedidos'[Status Pedido], "Vários")
			VAR Loja = SELECTEDVALUE('Lojas'[Loja], "Várias")
			VAR Canal = SELECTEDVALUE('Canais'[Canal], "Vários")
			RETURN
			"<div style='font-family:Segoe UI,Arial,sans-serif;color:#F8FAFC;background:#101B2D;border:1px solid #263A56;border-radius:14px;padding:18px 20px;box-sizing:border-box;width:100%;height:100%;'><div style='display:flex;justify-content:space-between;align-items:flex-start;'><div><div style='font-size:10px;color:#9FB0C7;letter-spacing:.08em;'>PEDIDO SELECIONADO</div><div style='font-size:28px;font-weight:800;margin-top:4px;'>#" & COALESCE(FORMAT(PedidoId, "0"), "—") & "</div></div><div style='background:#15233A;border:1px solid #263A56;border-radius:999px;padding:7px 12px;font-size:11px;font-weight:700;'>" & StatusPedido & "</div></div><div style='display:flex;gap:26px;margin-top:15px;font-size:11px;color:#9FB0C7;'><span>Loja: <b style='color:#F8FAFC;'>" & Loja & "</b></span><span>Canal: <b style='color:#F8FAFC;'>" & Canal & "</b></span><span>Valor: <b style='color:#F8FAFC;'>" & FORMAT([Valor Transacionado], "R$ #,##0.00", "pt-BR") & "</b></span></div></div>"
		```
		formatString: General
		displayFolder: "90 HTML"

	column Controle
		isHidden
		sourceColumn: [Controle]

	partition 'Métricas' = calculated
		mode: import
		source = ROW("Controle", 1)
