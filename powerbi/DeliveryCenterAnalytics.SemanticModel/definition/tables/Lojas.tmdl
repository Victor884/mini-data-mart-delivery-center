/// Dimensão de lojas; uma linha por loja.
table Lojas

	column 'Chave Loja'
		dataType: int64
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: store_id

	column Loja
		dataType: string
		sourceColumn: store_name

	column 'Segmento Loja'
		dataType: string
		sourceColumn: store_segment

	column 'Plano Loja'
		dataType: decimal
		summarizeBy: none
		sourceColumn: store_plan_price

	partition Lojas = m
		mode: import
		source =
			let
				Fonte = PostgreSQL.Database(#"Servidor PostgreSQL", #"Banco PostgreSQL", [Query = "SELECT DISTINCT store_id, store_name, store_segment, store_plan_price FROM mart.vw_pedidos_enriquecidos"])
			in
				Fonte
