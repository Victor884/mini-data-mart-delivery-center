/// Dimensão degenerada de pedidos usada como filtro comum e chave de drill-through.
table Pedido

	column 'Chave Pedido'
		dataType: int64
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: sk_pedido

	column 'Pedido ID'
		dataType: int64
		summarizeBy: none
		sourceColumn: order_id

	partition Pedido = m
		mode: import
		source =
			let
				Fonte = PostgreSQL.Database(#"Servidor PostgreSQL", #"Banco PostgreSQL", [Query = "SELECT sk_pedido, order_id FROM mart.vw_pedidos_enriquecidos"])
			in
				Fonte
