/// Dimensão de canais de venda; uma linha por canal.
table Canais

	column 'Chave Canal'
		dataType: int64
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: channel_id

	column Canal
		dataType: string
		sourceColumn: channel_name

	column 'Tipo Canal'
		dataType: string
		sourceColumn: channel_type

	partition Canais = m
		mode: import
		source =
			let
				Fonte = PostgreSQL.Database(#"Servidor PostgreSQL", #"Banco PostgreSQL", [Query = "SELECT DISTINCT channel_id, channel_name, channel_type FROM mart.vw_pedidos_enriquecidos"])
			in
				Fonte
